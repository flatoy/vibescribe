      },
      "accept": {},
      "why": "Karin is naturally slower than the 3.10 s beat; 1.12 keeps her relaxed (3.8 words per speech-second) and content keeps 'Klingt gut!' bright."
    },
    "L4": {
      "generation": {
        "speed": 0.97
